{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "apps/website",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.(png|jpg|jpeg|svg|webp|ico|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "^(?:(?:www\\.)?nekkoagent\\.com|www\\.agentnekko\\.com)$"
        }
      ],
      "destination": "https://agentnekko.com/:path*",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "^www\\.kotrain\\.com$" }],
      "destination": "https://kotrain.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "^(?:www\\.)?(?:kotrain\\.app|nekkos\\.app|nekkos\\.dev)$"
        }
      ],
      "destination": "https://kotrain.com/$1",
      "permanent": true
    }
  ]
}
